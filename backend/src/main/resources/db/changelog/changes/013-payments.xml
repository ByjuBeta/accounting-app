<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-payments" author="accounting-app">
        <createTable tableName="payments">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="organization_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_payments_organization"
                             references="organizations(id)"/>
            </column>
            <column name="payment_number" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_payments_customer" references="customers(id)"/>
            </column>
            <column name="payment_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="deposit_to_account_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_payments_deposit_account"
                             references="accounts(id)"/>
            </column>
            <column name="memo" type="VARCHAR(1000)"/>
            <column name="reference_number" type="VARCHAR(64)"/>
        </createTable>
        <addUniqueConstraint tableName="payments" columnNames="organization_id, payment_number"
                              constraintName="uq_payments_org_number"/>
        <createIndex indexName="idx_payments_customer" tableName="payments">
            <column name="customer_id"/>
        </createIndex>

        <createTable tableName="payment_applications">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="UUID"/>
            <column name="updated_by" type="UUID"/>
            <column name="payment_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_payment_applications_payment"
                             references="payments(id)" deleteCascade="true"/>
            </column>
            <column name="invoice_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_payment_applications_invoice"
                             references="invoices(id)"/>
            </column>
            <column name="amount_applied" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_payment_applications_payment" tableName="payment_applications">
            <column name="payment_id"/>
        </createIndex>
        <createIndex indexName="idx_payment_applications_invoice" tableName="payment_applications">
            <column name="invoice_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
