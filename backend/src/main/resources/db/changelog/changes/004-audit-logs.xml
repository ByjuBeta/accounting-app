<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-audit-logs" author="accounting-app">
        <createTable tableName="audit_logs">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="organization_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_audit_logs_organization"
                             references="organizations(id)"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints foreignKeyName="fk_audit_logs_user" references="users(id)"/>
            </column>
            <column name="ip_address" type="VARCHAR(64)"/>
            <column name="action" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="UUID"/>
            <column name="summary" type="VARCHAR(1000)"/>
            <column name="changes" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_audit_logs_org_created" tableName="audit_logs">
            <column name="organization_id"/>
            <column name="created_at" descending="true"/>
        </createIndex>
        <createIndex indexName="idx_audit_logs_entity" tableName="audit_logs">
            <column name="organization_id"/>
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
